# Copy to .env.local for local dev — same values go in GitHub repo Variables.

# Google Apps Script web app URL (see backend/SETUP.md). Powers leads,
# CMS content and the client-portal ops data. Leave empty for static mode
# (forms fall back to email).
VITE_SHEETS_API_URL=

# Google Analytics 4 Measurement ID (G-XXXXXXX). Leave empty to disable.
VITE_GA_MEASUREMENT_ID=

# Search Console verification token. Leave empty to disable.
VITE_GSC_VERIFICATION=

# Groq API key for the AI assistant + insights briefing.
# Get a free key at https://console.groq.com — leave empty for built-in fallbacks.
VITE_AI_API_KEY=

# Optional: override the AI model or endpoint.
# VITE_AI_MODEL=qwen/qwen3.8-27b
# VITE_AI_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
